  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "type": "stat",
      "title": "Total HTTP Requests",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "flask_http_request_total",
          "legendFormat": "requests"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Request Rate",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(flask_http_request_total[1m])",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Requests by Status",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(flask_http_request_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ],
